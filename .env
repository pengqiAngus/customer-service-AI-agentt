# Flask Application Settings
FLASK_ENV=development
FLASK_DEBUG=True
HOST=0.0.0.0
PORT=5000


# Model Training Settings
MODEL_NAME=Qwen/Qwen3-0.6B
TRAINING_DATA_PATH=./data/training-data
OUTPUT_MODEL_PATH=./models/fine_tuned_model
LORA_RANK=16
LORA_ALPHA=32
LEARNING_RATE=5e-5
NUM_EPOCHS=3
BATCH_SIZE=4

# RAG Knowledge Base Settings
KNOWLEDGE_BASE_PATH=./data/knowledge_files/
VECTOR_STORE_PATH=./data/vector_store/
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Database Settings (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=customer_service
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/customer_service

# Text2SQL Feature Toggle
ENABLE_TEXT2SQL=false
SQL_TABLES_INFO_PATH=./data/database_schema.json

# Memory Settings (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
MEMORY_TTL=3600

# Agent Settings
MAX_CONVERSATION_HISTORY=10
AGENT_TEMPERATURE=0.7
MAX_TOKENS=1000